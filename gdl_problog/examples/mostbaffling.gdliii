; "The Most Baffling Case of All" as a sequential epistemic game.
; Random chooses one of the logically possible trials and one of three public,
; cyclic assignments of A/B/C to the first/second/third defendant positions.
; There are 12 valid trials, four for each guilty position. The public
; assignment makes each named defendant equally likely to be guilty (1/3).
;
; Statements by position:
;   first: claims the first defendant innocent/guilty
;   second: claims the second defendant innocent/guilty
;   third: claims the first defendant innocent/guilty
;
; Alice (reader) never learns the statements' exact contents. She learns in
; sequence who received which information, and whether each character could
; solve. A character solves iff they know the guilty identity from their
; observations. The later reports are evaluated against each character's own
; accumulated observation history.

(role reader)
(role random)
(role jabberwocky)
(role tweedledee)
(role tweedledum)
(role humpty)

(position first) (position second) (position third)
(suspect a) (suspect b) (suspect c)
(statement innocent) (statement guilty)

(same first first) (same second second) (same third third)
(different first second) (different first third)
(different second first) (different second third)
(different third first) (different third second)

; In the randomized variants, the last defendant's accusation target changes
; with the guilty position so the three versions retain the same structure.

; The extra randomness publicly rotates the names through the three positions.
(validMap a b c)
(validMap b c a)
(validMap c a b)

; Truth of each positional statement, given the guilty position.
(<= (trueFor ?g first guilty) (same ?g first))
(<= (trueFor ?g first innocent) (different ?g first))
(<= (trueFor ?g second guilty) (same ?g second))
(<= (trueFor ?g second innocent) (different ?g second))
(<= (trueFor ?g third guilty) (same ?g first))
(<= (trueFor ?g third innocent) (different ?g first))

; These are exactly the case/guilt combinations with at most one true claim.
(<= (twoTrueIn ?g ?s1 ?s2 ?s3)
    (trueFor ?g first ?s1) (trueFor ?g second ?s2) (statement ?s3))
(<= (twoTrueIn ?g ?s1 ?s2 ?s3)
    (trueFor ?g first ?s1) (trueFor ?g third ?s3) (statement ?s2))
(<= (twoTrueIn ?g ?s1 ?s2 ?s3)
    (trueFor ?g second ?s2) (trueFor ?g third ?s3) (statement ?s1))
(<= (validCase ?g ?s1 ?s2 ?s3)
    (position ?g)
    (statement ?s1)
    (statement ?s2)
    (statement ?s3)
    (not (twoTrueIn ?g ?s1 ?s2 ?s3)))

(init (step 0))
(<= (next (step 1)) (true (step 0)))
(<= (next (step 2)) (true (step 1)))
(<= (next (step 3)) (true (step 2)))
(<= (next (step 4)) (true (step 3)))
(<= (next (step 5)) (true (step 4)))
(<= (next (step 6)) (true (step 5)))
(<= (next (step 7)) (true (step 6)))
(<= (next (step 8)) (true (step 7)))
(<= (next (step 9)) (true (step 8)))
(<= (terminal) (true (step 9)))

; Step 0: choose a valid trial and a public identity order.
(<= (legal random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third))
    (true (step 0))
    (validCase ?g ?s1 ?s2 ?s3)
    (validMap ?first ?second ?third))
(<= (next (case ?g ?s1 ?s2 ?s3))
    (does random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third)))
(<= (next (mapping ?first ?second ?third))
    (does random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third)))
(<= (next (case ?g ?s1 ?s2 ?s3))
    (true (case ?g ?s1 ?s2 ?s3)))
(<= (next (mapping ?first ?second ?third))
    (true (mapping ?first ?second ?third)))

(<= (identityAt first ?a) (true (mapping ?a ?b ?c)))
(<= (identityAt second ?b) (true (mapping ?a ?b ?c)))
(<= (identityAt third ?c) (true (mapping ?a ?b ?c)))
(<= (positionStatement first ?s1) (true (case ?g ?s1 ?s2 ?s3)))
(<= (positionStatement second ?s2) (true (case ?g ?s1 ?s2 ?s3)))
(<= (positionStatement third ?s3) (true (case ?g ?s1 ?s2 ?s3)))
(<= (statementByPosition first ?speaker ?status ?speaker)
    (identityAt first ?speaker)
    (positionStatement first ?status))
(<= (statementByPosition second ?speaker ?status ?speaker)
    (identityAt second ?speaker)
    (positionStatement second ?status))
(<= (statementByPosition third ?speaker ?status ?first)
    (identityAt third ?speaker)
    (identityAt first ?first)
    (positionStatement third ?status))
(<= (guilty ?who)
    (true (case ?g ?s1 ?s2 ?s3))
    (identityAt ?g ?who))

(<= (claim ?speaker ?status ?target)
    (statementByPosition first ?speaker ?status ?target))
(<= (claim ?speaker ?status ?target)
    (statementByPosition second ?speaker ?status ?target))
(<= (claim ?speaker ?status ?target)
    (statementByPosition third ?speaker ?status ?target))
(<= (trueStatement ?speaker)
    (claim ?speaker guilty ?target)
    (guilty ?target))
(<= (trueStatement ?speaker)
    (claim ?speaker innocent ?target)
    (not (guilty ?target)))
(<= (twoTrue)
    (trueStatement ?one)
    (trueStatement ?two)
    (distinct ?one ?two))
(<= (atMostOneTrue) (not (twoTrue)))

; A character solves exactly when they know which named defendant is guilty.
(<= (solves ?person) (knows ?person (guilty a)))
(<= (solves ?person) (knows ?person (guilty b)))
(<= (solves ?person) (knows ?person (guilty c)))

; Quiet moves keep the timed information sequence explicit.
(quietRole reader) (quietRole jabberwocky) (quietRole tweedledee)
(<= (legal ?r noop)
    (quietRole ?r)
    (or (true (step 0)) (true (step 1)) (true (step 2))
        (true (step 3)) (true (step 4)) (true (step 5))
        (true (step 6)) (true (step 7)) (true (step 8))))
(<= (legal humpty noop)
    (or (true (step 0)) (true (step 1)) (true (step 2))
        (true (step 3)) (true (step 4)) (true (step 5))
        (true (step 6))))
(<= (legal tweedledum noop)
    (or (true (step 0)) (true (step 1)) (true (step 2))
        (true (step 3)) (true (step 5)) (true (step 6))
        (true (step 7)) (true (step 8))))
(<= (legal tweedledum (ask second)) (true (step 4)))
(<= (legal tweedledum (ask third)) (true (step 4)))
(<= (legal humpty needMoreData) (true (step 7)) (not (solves humpty)))
(<= (legal humpty alreadySolved) (true (step 7)) (solves humpty))
(<= (legal humpty reportSolved) (true (step 8)) (solves humpty))
(<= (legal humpty reportUnsolved) (true (step 8)) (not (solves humpty)))
(<= (legal random noop)
    (not (true (step 0)))
    (or (true (step 1)) (true (step 2)) (true (step 3))
        (true (step 4)) (true (step 5)) (true (step 6))
        (true (step 7)) (true (step 8))))

; The public identity order and Jabberwocky's exact statements are observed
; after the random setup. Other roles do not get Jabberwocky's private claims.
(informedRole reader) (informedRole jabberwocky) (informedRole tweedledee)
(informedRole tweedledum) (informedRole humpty)
(<= (sees ?r (identityOrder ?first ?second ?third))
    (does random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third))
    (informedRole ?r))
(<= (sees jabberwocky (statement ?first ?s1 ?first))
    (does random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third)))
(<= (sees jabberwocky (statement ?second ?s2 ?second))
    (does random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third)))
(<= (sees jabberwocky (statement ?third ?s3 ?first))
    (does random (choose ?g ?s1 ?s2 ?s3 ?first ?second ?third)))

; Step 1 -> 2: Alice and both Tweedles learn that Jabberwocky got all claims
; and whether he could solve from them.
(jabberwockyAudience reader) (jabberwockyAudience tweedledee)
(jabberwockyAudience tweedledum)
(<= (sees ?r jabberwockyWasToldAll)
    (true (step 1))
    (jabberwockyAudience ?r))
(<= (sees ?r jabberwockySolved)
    (true (step 1))
    (jabberwockyAudience ?r)
    (solves jabberwocky))
(<= (sees ?r jabberwockyUnsolved)
    (true (step 1))
    (jabberwockyAudience ?r)
    (not (solves jabberwocky)))

; Step 2 -> 3: Tweedledee is given the first defendant's exact statement.
; Alice learns only that he received it, and that he could not solve before it.
(<= (sees tweedledee (firstStatement ?speaker ?status ?target))
    (true (step 2))
    (statementByPosition first ?speaker ?status ?target))
(<= (sees reader tweedledeeWasGivenFirstStatement)
    (true (step 2)))
(<= (sees reader tweedledeeInitiallyUnsolved)
    (true (step 2))
    (not (solves tweedledee)))
(<= (next tweedledeeInitiallyUnsolved)
    (true (step 2))
    (not (solves tweedledee)))
(<= (next tweedledeeInitiallyUnsolved)
    (true tweedledeeInitiallyUnsolved))

; Step 3 -> 4: Alice learns whether Tweedledee could solve after that clue.
; Humpty later gets the reports and knows the clue was given, not its content.
(<= (sees reader tweedledeeSolved)
    (true (step 3))
    (solves tweedledee))
(<= (sees reader tweedledeeUnsolved)
    (true (step 3))
    (not (solves tweedledee)))
(<= (sees humpty jabberwockyWasToldAll)
    (true (step 3)))
(<= (sees humpty jabberwockySolved)
    (true (step 3))
    (solves jabberwocky))
(<= (sees humpty jabberwockyUnsolved)
    (true (step 3))
    (not (solves jabberwocky)))
(<= (sees humpty tweedledeeWasAskedAboutFirst)
    (true (step 3)))
(<= (sees humpty tweedledeeInitiallyUnsolved)
    (true (step 3))
    (true tweedledeeInitiallyUnsolved))
(<= (sees humpty tweedledeeWasGivenFirstStatement)
    (true (step 3)))
(<= (sees humpty tweedledeeSolved)
    (true (step 3))
    (solves tweedledee))
(<= (sees humpty tweedledeeUnsolved)
    (true (step 3))
    (not (solves tweedledee)))

; Step 4: Tweedledum privately asks about the second or third position.
(<= (next (question ?position)) (does tweedledum (ask ?position)))
(<= (next (question ?position)) (true (question ?position)))

; Step 5 -> 6: Tweedledum alone learns the requested statement. Alice and
; Humpty know an answer was given, but not its content.
(<= (sees tweedledum (askedStatement ?position ?speaker ?status ?target))
    (true (step 5))
    (true (question ?position))
    (statementByPosition ?position ?speaker ?status ?target))
(<= (sees reader tweedledumWasAskedSecondOrThird)
    (true (step 5)))
(<= (sees reader tweedledumWasToldAnswer)
    (true (step 5)))
(<= (sees reader tweedledumWasNotToldAboutTweedledee)
    (true (step 5)))
(<= (sees humpty tweedledumWasAskedSecondOrThird)
    (true (step 6)))
(<= (sees humpty tweedledumWasToldAnswer)
    (true (step 6)))
(<= (sees humpty tweedledumWasNotToldAboutTweedledee)
    (true (step 6)))
(<= (sees reader tweedledumSolved)
    (true (step 6))
    (solves tweedledum))
(<= (sees reader tweedledumUnsolved)
    (true (step 6))
    (not (solves tweedledum)))
(<= (sees humpty tweedledumSolved)
    (true (step 6))
    (solves tweedledum))
(<= (sees humpty tweedledumUnsolved)
    (true (step 6))
    (not (solves tweedledum)))

; Step 7: Humpty says he needs more information before learning the question.
; His two possible reports depend on whether he already knows the culprit.
(<= (sees reader humptyNeedsMoreData)
    (does humpty needMoreData))
(<= (sees reader humptyAlreadySolved)
    (does humpty alreadySolved))

; Step 7 -> 8: Humpty alone learns which position Tweedledum asked about.
; Neither Humpty nor Alice is told the answer Tweedledum received.
(<= (sees humpty (tweedledumAskedAbout ?position))
    (true (step 7))
    (true (question ?position)))
(<= (sees humpty tweedledumAnswerNotRemembered)
    (true (step 7)))
(<= (sees reader humptyWasToldWhichQuestion)
    (true (step 7)))
(<= (sees reader tweedledumAnswerNotRemembered)
    (true (step 7)))

; Step 8 -> 9: Alice learns only whether Humpty could solve after that clue.
(<= (sees reader humptySolved)
    (does humpty reportSolved))
(<= (sees reader humptyUnsolved)
    (does humpty reportUnsolved))

; The intended history ends with the reader knowing the guilty identity.
(<= (goal reader 100) (solves reader))
(<= (goal reader 0) (not (solves reader)))
(goal jabberwocky 0)
(goal tweedledee 0)
(goal tweedledum 0)
(goal humpty 0)
(goal random 0)
