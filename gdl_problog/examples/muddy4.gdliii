(role ann)
(role bob)
(role cat)
(role dan)
(role random)

(init (round 0))

(yesno 0) (yesno 1) (yes 1)
(<= (legal random (muddy ?a ?b ?c ?d)) (true (round 0)) (yesno ?a) (yesno ?b) (yesno ?c) (yesno ?d) (or (yes ?a) (yes ?b) (yes ?c) (yes ?d)))
(<= (legal random noop) (not (true (round 0))))
(<= (legal ?c noop) (role ?c) (distinct ?c random) (true (round 0)))

(<= (next (has ann mud)) (does random (muddy 1 ?b ?c ?d)))
(<= (next (has bob mud)) (does random (muddy ?a 1 ?c ?d)))
(<= (next (has cat mud)) (does random (muddy ?a ?b 1 ?d)))
(<= (next (has dan mud)) (does random (muddy ?a ?b ?c 1)))
(<= (next (has ?c mud)) (true (has ?c mud)))

(<= (next (round 1)) (true (round 0)))
(<= (next (round 2)) (true (round 1)))
(<= (next (round 3)) (true (round 2)))
(<= (next (round 4)) (true (round 3)))
(<= (next (round 5)) (true (round 4)))

; Every child sees the mud on the others, but not their own
(<= (sees ann (dirt bob)) (does random (muddy ?a 1 ?c ?d)))
(<= (sees ann (dirt cat)) (does random (muddy ?a ?b 1 ?d)))
(<= (sees ann (dirt dan)) (does random (muddy ?a ?b ?c 1)))
(<= (sees bob (dirt ann)) (does random (muddy 1 ?b ?c ?d)))
(<= (sees bob (dirt cat)) (does random (muddy ?a ?b 1 ?d)))
(<= (sees bob (dirt dan)) (does random (muddy ?a ?b ?c 1)))
(<= (sees cat (dirt ann)) (does random (muddy 1 ?b ?c ?d)))
(<= (sees cat (dirt bob)) (does random (muddy ?a 1 ?c ?d)))
(<= (sees cat (dirt dan)) (does random (muddy ?a ?b ?c 1)))
(<= (sees dan (dirt ann)) (does random (muddy 1 ?b ?c ?d)))
(<= (sees dan (dirt bob)) (does random (muddy ?a 1 ?c ?d)))
(<= (sees dan (dirt cat)) (does random (muddy ?a ?b 1 ?d)))

(<= (isMuddy ?c) (true (has ?c mud)))
(<= (legal ?c (say yes)) (role ?c) (distinct ?c random) (knows ?c (isMuddy ?c)) (not (true (round 0))))
(<= (legal ?c (say no)) (role ?c) (distinct ?c random) (not (knows ?c (isMuddy ?c))) (not (true (round 0))))
(<= (sees ?c (said ?d ?x)) (role ?c) (does ?d (say ?x)))

(<= (next done) (does ?c (say yes)))
(<= (next done) (true done))
(<= (terminal) (true done))
(<= (terminal) (true (round 5)))
