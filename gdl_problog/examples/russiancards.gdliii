(init (phase deal))

; Nature deals one of the 140 possible partitions.
(<= (legal random (deal ?a ?b ?c ?d ?e ?f ?g))
    (true (phase deal))
    (deal ?a ?b ?c ?d ?e ?f ?g))
(<= (legal alice noop) (true (phase deal)))
(<= (legal bob noop) (true (phase deal)))
(<= (legal eve noop) (true (phase deal)))

; Alice announces any Fano plane in which her hand is a line.
(<= (legal alice (announce ?plane))
    (true (phase announce))
    (true (aliceHand ?a ?b ?c))
    (fanoLine ?plane ?a ?b ?c))
(<= (legal bob noop) (true (phase announce)))
(<= (legal eve noop) (true (phase announce)))
(<= (legal random noop) (not (true (phase deal))))

; Save the private hands and advance the protocol.
(<= (next (phase announce)) (true (phase deal)))
(<= (next (phase response)) (true (phase announce)))
(<= (next (aliceHand ?a ?b ?c))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (next (bobHand ?d ?e ?f))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (next (eveCard ?g))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (next (aliceHand ?a ?b ?c)) (true (aliceHand ?a ?b ?c)))
(<= (next (bobHand ?a ?b ?c)) (true (bobHand ?a ?b ?c)))
(<= (next (eveCard ?a)) (true (eveCard ?a)))
(<= (next (aliceHas ?a))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (next (aliceHas ?b))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (next (aliceHas ?c))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (next (aliceHas ?card)) (true (aliceHas ?card)))
(<= (next (announced ?plane)) (does alice (announce ?plane)))
(<= (next (announced ?plane)) (true (announced ?plane)))

; Players observe their own hands. Alice's announcement is public.
(<= (sees alice (aliceHand ?a ?b ?c))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (sees bob (bobHand ?d ?e ?f))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (sees eve (eveCard ?g))
    (does random (deal ?a ?b ?c ?d ?e ?f ?g)))
(<= (sees alice (announced ?plane)) (does alice (announce ?plane)))
(<= (sees bob (announced ?plane)) (does alice (announce ?plane)))
(<= (sees eve (announced ?plane)) (does alice (announce ?plane)))

(<= (terminal) (true (phase response)))
(goal alice 0)
(goal bob 0)
(goal eve 0)
(goal random 0)
