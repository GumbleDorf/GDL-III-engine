;@instructions MUDDY CHILDREN (THREE CHILDREN)
;@instructions Ann, Bob, and Cat can see mud on the other children's foreheads, but not their own. The group is told that at least one child is muddy.
;@instructions In each public round, each child says yes if they know they are muddy, otherwise no. Use the sequence of answers to determine who is muddy.
;@instructions Query a child's belief with :q ann isMuddy(ann), :q bob isMuddy(bob), or :q cat isMuddy(cat).

(role ann)
(role bob)
(role cat)
(role random)

(init (round 0))

(yesno 0) (yesno 1) (yes 1)
(<= (legal random (muddy ?a ?b ?c)) (true (round 0)) (yesno ?a) (yesno ?b) (yesno ?c) (or (yes ?a) (yes ?b) (yes ?c)))
(<= (legal random noop) (not (true (round 0))))
(<= (legal ?c noop) (role ?c) (distinct ?c random) (true (round 0)))

(<= (next (has ann mud)) (does random (muddy 1 ?b ?c)))
(<= (next (has bob mud)) (does random (muddy ?a 1 ?c)))
(<= (next (has cat mud)) (does random (muddy ?a ?b 1)))
(<= (next (has ?c mud)) (true (has ?c mud)))

(<= (next (round 1)) (true (round 0)))
(<= (next (round 2)) (true (round 1)))
(<= (next (round 3)) (true (round 2)))
(<= (next (round 4)) (true (round 3)))

; Every child sees the mud on the others, but not their own
(<= (sees ann (dirt bob)) (does random (muddy ?a 1 ?c)))
(<= (sees ann (dirt cat)) (does random (muddy ?a ?b 1)))
(<= (sees bob (dirt ann)) (does random (muddy 1 ?b ?c)))
(<= (sees bob (dirt cat)) (does random (muddy ?a ?b 1)))
(<= (sees cat (dirt ann)) (does random (muddy 1 ?b ?c)))
(<= (sees cat (dirt bob)) (does random (muddy ?a 1 ?c)))

(<= (isMuddy ?c) (true (has ?c mud)))
(<= (legal ?c (say yes)) (role ?c) (distinct ?c random) (knows ?c (isMuddy ?c)) (not (true (round 0))))
(<= (legal ?c (say no)) (role ?c) (distinct ?c random) (not (knows ?c (isMuddy ?c))) (not (true (round 0))))
(<= (sees ?c (said ?d ?x)) (role ?c) (does ?d (say ?x)))

(<= (next done) (does ?c (say yes)))
(<= (next done) (true done))
(<= (terminal) (true done))
(<= (terminal) (true (round 4)))
